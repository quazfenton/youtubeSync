      "typeVersion": 1,
      "position": [
        736,
        576
      ]
    },
    {
      "parameters": {
        "command": "cd /home/workspace/youtubeSync && python monitor.py"
      },
      "id": "2935d9bc-343f-4482-89ea-7eb111853440",
      "name": "Run YouTube Monitor Script",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        960,
        192
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "={{ $json.exitCode === 0 ? 'success' : 'failed' }}"
            },
            {
              "name": "output",
              "value": "={{ $json.stdout }}"
            },
            {
              "name": "errors",
              "value": "={{ $json.stderr }}"
            },
            {
              "name": "timestamp",
              "value": "={{ new Date().toISOString() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "8ce2572d-9f88-4375-8323-a113112537d4",
      "name": "Format Execution Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        1184,
        192
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "parsedOutput",
              "value": "={{ $json.errors }}"
            },
            {
              "name": "newPlaylistsAdded",
              "value": "={{ (($json.errors || '').includes('No new playlists detected since last check') ? 0 : parseInt(($json.errors || '').match(/Playlists awaiting sync: (\\d+)/)?.[1]) || 0) }}"
            },
            {
              "name": "playlistsAwaitingSync",
              "value": "={{ parseInt(($json.errors || '').match(/Playlists awaiting sync: (\\d+)/)?.[1]) || 0 }}"
            }
          ]
        },
        "options": {}
      },
      "id": "ba4fc08a-caf4-4e9e-8f42-ec5141b18647",
      "name": "Parse Results and Count New Playlists",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        1408,
        192
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "={{ $('Parse Results and Count New Playlists').first().json.status }}",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "0fcd821d-2130-446a-9557-644ab1b7983d",
              "leftValue": "={{ $('Parse Results and Count New Playlists').first().json.status }}",
              "rightValue": "success",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "64369f2b-7d47-4e57-b25b-fba4dbdd1796",
      "name": "Check Execution Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1632,
        192
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "message",
              "value": "={{ 'YouTube Monitor Script executed successfully at ' + $('Parse Results and Count New Playlists').first().json.timestamp + '. New playlists added: ' + ($('Parse Results and Count New Playlists').first().json.newPlaylistsAdded || 0) + ', Playlists awaiting sync: ' + ($('Parse Results and Count New Playlists').first().json.playlistsAwaitingSync || 0) }}"
            },
            {
              "name": "status",
              "value": "success"
            },
            {
              "name": "emailAddress",
              "value": "={{ $json.emailAddress || 'admin@example.com' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "01a2fc7a-a1ab-4533-9429-708e2b7680a5",
      "name": "Success Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        1856,
        96
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "message",
              "value": "={{ 'YouTube Monitor Script failed at ' + $('Parse Results and Count New Playlists').first().json.timestamp + '. Error: ' + ($('Parse Results and Count New Playlists').first().json.errors || 'Unknown error') }}"
            },
            {
              "name": "status",
              "value": "failed"
            },
            {
              "name": "emailAddress",
              "value": "={{ $json.emailAddress || 'admin@example.com' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "67fe2e27-d661-43b7-9c0d-e60ba933c9c8",
